# Fitter Cloudflare Worker Gateway Environment Variables
# NEVER commit production keys to git! Set them via `wrangler secret put <KEY>` in production.

# VLM Provider Keys (set as wrangler secrets in production)
GEMINI_API_KEY=your_gemini_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Phase 9: VLM Provider Routing
# Primary VLM provider for /v1/analyze-meal and /v1/recalculate.
# Values: "openrouter" (default, production) | "gemini" | "groq" | "mock" (dev only)
VLM_PRIMARY_PROVIDER=openrouter

# Allow fallback to secondary providers if primary fails.
# Set "false" to prevent silent provider switching in strict production environments.
VLM_ALLOW_FALLBACK=true

# Operational Flags
FITTER_KILL_SWITCH=false
