<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="MacroVision"
        android:supportsRtl="true"
        android:theme="@style/Theme.MacroVision">
        
        <activity
            android:name="com.fitter.app.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.MacroVision">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Google Mobile Ads (AdMob) Sample Application ID for development & testing -->
        <!-- Replace this with your actual AdMob App ID from the AdMob console before production release -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713"/>
        
    </application>

</manifest>
